---
// Comparison vs "typical remote apps". Signal color appears here and in
// form errors ONLY — it always means "the bad option".
---

<section class="compare">
  <div class="container">
    <p class="ecp">POST /keypress/Back</p>
    <h2>Clicker vs. the usual remote apps</h2>

    <div class="table-wrap" tabindex="0" role="region" aria-label="Feature comparison">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            <th scope="col" class="col-us">Clicker</th>
            <th scope="col" class="col-them">Typical remote apps</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Price</th>
            <td class="col-us" data-who="Clicker">One-time, yours forever</td>
            <td class="col-them" data-who="Typical apps">Weekly subscription</td>
          </tr>
          <tr>
            <th scope="row">Ads</th>
            <td class="col-us" data-who="Clicker">Never</td>
            <td class="col-them" data-who="Typical apps">Banner and video ads</td>
          </tr>
          <tr>
            <th scope="row">Trackers &amp; analytics</th>
            <td class="col-us" data-who="Clicker">None</td>
            <td class="col-them" data-who="Typical apps">Usually several</td>
          </tr>
          <tr>
            <th scope="row">Account required</th>
            <td class="col-us" data-who="Clicker">No</td>
            <td class="col-them" data-who="Typical apps">Often</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="compare-note">
      Based on common patterns across popular third-party remote apps. No
      specific product implied.
    </p>
  </div>
</section>

<style>
  .compare { padding-block: calc(var(--space) * 12); }

  .compare h2 { margin-top: calc(var(--space) * 3); }

  .table-wrap {
    margin-top: calc(var(--space) * 5);
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }

  @media (min-width: 561px) {
    table { min-width: 560px; }
  }

  /* Under 560px the table re-flows into stacked blocks so the signal-red
     column — the whole point of this section — is never scrolled off-screen. */
  @media (max-width: 560px) {
    .table-wrap { overflow-x: visible; }

    thead { display: none; }

    tbody, tbody tr, tbody th, tbody td { display: block; width: 100%; }

    tbody tr {
      padding-block: calc(var(--space) * 2);
      border-bottom: 1px solid var(--line);
    }

    tbody tr:last-child { border-bottom: none; }

    tbody th {
      padding: 0 0 var(--space);
      border-bottom: none;
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 0.04em;
      color: var(--ink-faint);
      font-weight: 500;
    }

    tbody td {
      padding: 2px 0 2px calc(var(--space) * 2.5);
      border-bottom: none;
      border-left: 3px solid currentColor;
      margin-bottom: 4px;
    }

    /* thead is hidden here, so name the side explicitly — the meaning must
       not rest on teal-vs-red alone. */
    tbody td::before {
      content: attr(data-who) " ";
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--ink-faint);
      display: block;
    }
  }

  th, td {
    text-align: left;
    padding: calc(var(--space) * 2) calc(var(--space) * 2.5);
    border-bottom: 1px solid var(--line);
  }

  thead th {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  tbody th { font-weight: 600; color: var(--ink); }

  .col-us { color: var(--teal-deep); font-weight: 600; }
  thead .col-us { color: var(--teal-deep); }

  .col-them { color: var(--signal); }
  thead .col-them { color: var(--signal); }

  tbody tr:last-child th,
  tbody tr:last-child td { border-bottom: none; }

  .compare-note {
    margin-top: calc(var(--space) * 3);
    font-size: 13px;
    color: var(--ink-faint);
  }
</style>
