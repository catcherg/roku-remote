---
// Three value props on the sand band (its one allowed appearance as a
// surface), plus the channel-grid screenshot showing breadth.
---

<section class="values">
  <div class="container">
    <p class="ecp">GET /query/device-info</p>
    <h2>Three promises</h2>

    <div class="values-grid">
      <div class="values-cards">
        <article class="card">
          <h3>One price, forever</h3>
          <p>
            Try it free for 7 days, then pay once and it’s yours — every
            future update included. Remote apps that charge weekly are the
            problem Clicker exists to fix.
          </p>
        </article>
        <article class="card">
          <h3>Connected in seconds</h3>
          <p>
            Open the app and it finds every Roku on your Wi-Fi. Switch between
            devices with a tap, type with your keyboard, launch channels, and
            control volume and power on Roku TVs.
          </p>
        </article>
        <article class="card">
          <h3>Private by design</h3>
          <p>
            No account. No trackers. Commands go straight from your phone to
            your Roku over your own Wi-Fi — nothing leaves your network.
          </p>
        </article>
      </div>

      <figure class="values-media">
        <div class="phone">
          <div class="phone-screen">
            <img
              src="/screenshots/channels.png"
              alt="Clicker’s channel grid: your Roku channels with their icons, one tap to launch"
              width="402"
              height="874"
              loading="lazy"
            />
          </div>
        </div>
        <figcaption>Your channels, one tap away.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .values {
    background: var(--sand);
    padding-block: calc(var(--space) * 12);
  }

  .values h2 { margin-top: calc(var(--space) * 3); }

  .values-grid {
    margin-top: calc(var(--space) * 6);
    display: grid;
    gap: calc(var(--space) * 6);
    align-items: center;
  }

  @media (min-width: 900px) {
    .values-grid { grid-template-columns: 7fr 4fr; }
  }

  .values-cards {
    display: grid;
    gap: calc(var(--space) * 2.5);
  }

  .card {
    background: var(--card);
    border-radius: var(--radius-key);
    padding: calc(var(--space) * 3.5) calc(var(--space) * 4);
    border: 1px solid rgb(14 20 23 / 0.06);
  }

  .card h3 { margin-bottom: var(--space); }
  .card p { font-size: 16px; }

  .values-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--space) * 2);
  }

  .phone {
    width: min(240px, 70vw);
    border-radius: 40px;
    padding: 8px;
    background: #1a1a1e;
    box-shadow: 0 18px 36px -14px rgb(14 20 23 / 0.3);
  }

  .phone-screen {
    border-radius: 32px;
    overflow: hidden;
    background: var(--screen);
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-faint);
  }
</style>
