---
// Hero: headline + trial line + App Store status chip + the signature
// moment — a phone running the real app, with the eyes-free swipe gesture
// animating over the screenshot. This is the page's ONE orchestrated
// animation (WEBSITE.md); everything below it stays still.
import { Image } from "astro:assets";
import remoteShot from "../assets/remote.png";
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="ecp">POST /keypress/Select</p>
      <h1>The remote Roku <span class="keycap">deserves</span>.</h1>
      <p class="hero-sub">
        Free for 7 days. Then one price, forever.
        No ads, no subscriptions, no account.
      </p>
      <div class="hero-actions">
        <a href="#beta" class="btn btn-primary">Get a beta invite</a>
        <!-- TODO(launch): replace this status chip with Apple's official
             App Store badge asset (download from Apple Marketing Tools —
             do not hand-draw the badge) linked to the store page. -->
        <p class="store-status">App Store · soon</p>
      </div>
    </div>

    <div class="hero-device">
      <div class="phone">
        <div class="phone-screen">
          <Image
            src={remoteShot}
            alt="Clicker's remote screen: a full-screen swipe surface with Back, Home, play/pause and replay keys"
            widths={[400, 560, 804]}
            sizes="(min-width: 900px) 280px, 78vw"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Swipe overlay: a fingertip draws a trail up the swipe surface
               and the app answers with a chevron tick. One gesture, one loop —
               mirrors RemoteControlView's finger-tracking trail. -->
          <svg class="swipe" viewBox="0 0 402 874" aria-hidden="true" fill="none">
            <path
              class="trail"
              d="M201 430 C 205 380, 197 320, 201 260"
              stroke="var(--teal-bright)"
              stroke-width="10"
              stroke-linecap="round"
            />
            <circle class="tip" r="17" fill="var(--teal-bright)" />
            <path
              class="tick"
              d="M181 218 L201 198 L221 218"
              stroke="var(--teal-bright)"
              stroke-width="8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: calc(var(--space) * 10) calc(var(--space) * 12); }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--space) * 8);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 7fr 5fr; }
  }

  .hero-copy .ecp { margin-bottom: calc(var(--space) * 3); display: block; }

  /* The signature: the word the sentence turns on, set as a remote key.
     Teal fill + ink text is exactly how the app draws a prominent key
     (RemoteKeyStyle, prominent: true). */
  .keycap {
    display: inline-block;
    background: var(--teal);
    color: var(--ink);
    border-radius: 0.24em;
    padding: 0.04em 0.15em 0.09em;
    line-height: 0.92;
    margin-inline: -0.03em 0;
  }

  .hero-sub {
    margin-top: calc(var(--space) * 3);
    font-size: 20px;
    max-width: 26em;
  }

  .hero-actions {
    margin-top: calc(var(--space) * 5);
    display: flex;
    align-items: center;
    gap: calc(var(--space) * 3);
    flex-wrap: wrap;
  }

  .hero-actions .btn { text-decoration: none; }

  /* Status, not a control — no button semantics, no disabled affordance. */
  .store-status {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  /* ---------- Phone ---------- */
  .hero-device { display: flex; justify-content: center; }

  .phone {
    width: min(300px, 78vw);
    border-radius: 48px;
    padding: 10px;
    background: #1a1a1e; /* device chassis, not a surface token */
    box-shadow:
      0 2px 6px rgb(14 20 23 / 0.18),
      0 24px 48px -16px rgb(14 20 23 / 0.35);
  }

  .phone-screen {
    position: relative;
    border-radius: 38px;
    overflow: hidden;
    background: var(--screen);
  }

  .phone-screen :global(img) { width: 100%; height: auto; }

  .swipe { position: absolute; inset: 0; }

  /* ---------- The one orchestrated moment ----------
     5s loop: fingertip travels up the swipe surface drawing a trail, the
     app answers with a chevron tick, then rest. Hidden entirely under
     reduced motion. */
  .trail, .tip, .tick { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .trail {
      stroke-dasharray: 180;
      stroke-dashoffset: 180;
      animation: draw 5s ease-out infinite;
    }

    .tip { animation: travel 5s ease-out infinite; }
    .tick { animation: tick 5s ease-out infinite; }

    @keyframes draw {
      0%        { stroke-dashoffset: 180; opacity: 0; }
      6%        { opacity: 0.9; }
      22%       { stroke-dashoffset: 0; opacity: 0.9; }
      40%, 100% { stroke-dashoffset: 0; opacity: 0; }
    }

    @keyframes travel {
      0%        { opacity: 0; transform: translate(201px, 430px); }
      6%        { opacity: 1; }
      22%       { transform: translate(201px, 260px); opacity: 1; }
      34%, 100% { transform: translate(201px, 260px); opacity: 0; }
    }

    @keyframes tick {
      0%, 20%   { opacity: 0; transform: translateY(6px); }
      26%       { opacity: 1; transform: translateY(0); }
      44%, 100% { opacity: 0; transform: translateY(0); }
    }
  }
</style>
